<%#
  ============================================================================
  FILE: views/staf.ejs
  ============================================================================
  UI/UX Staf Dapur Khusus KDS (Kitchen Display System) + CRUD Menu Database:
  - Kartu Antrean Besar & Kontras Tinggi (Mudah dibaca sambil masak)
  - Tombol Aksi Sentuh Ekstra Besar (1 Sentuhan Langsung Ubah Status / Kunci Habis)
  - Notifikasi Suara Audio Beep (Web Audio API) Setiap Pesanan Baru Masuk
  - Fitur CRUD Lengkap (Tambah Menu POST /api/produk, Edit Menu PUT /api/produk/:id,
    Hapus Menu DELETE /api/produk/:id) terhubung langsung ke PostgreSQL (Sequelize)
%>
<%- include('partials/header', { judulHalaman: 'Layar Dapur & Manajemen Menu (CRUD)', halamanAktif, appConfig }) %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-5 space-y-5">
  
  <!-- Alert Pembatasan Hak Akses Jika Ada -->
  <% if (typeof pesanAksesDitolak !== 'undefined' && pesanAksesDitolak) { %>
    <div role="alert" class="rounded-2xl border border-amber-300 bg-amber-50 p-4 text-xs sm:text-sm text-amber-950 flex items-center justify-between gap-3 shadow-xs">
      <span><strong>Pemberitahuan:</strong> <%= pesanAksesDitolak %></span>
      <a href="/login?ganti=1" class="px-3.5 py-1.5 rounded-xl bg-stone-900 text-white text-xs font-semibold">
        Masuk Akun Pemilik
      </a>
    </div>
  <% } %>

  <!-- Bar Atas Dapur: Status Petugas & Kontrol Cepat -->
  <div class="bg-white rounded-2xl border border-stone-200/90 p-4 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class="w-10 h-10 rounded-xl bg-stone-900 text-white flex items-center justify-center font-bold text-base">
        🍳
      </span>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-base sm:text-lg font-bold text-stone-900 leading-tight">
            Layar Dapur &amp; Manajemen Menu Database
          </h1>
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        </div>
        <p class="text-xs text-stone-500 mt-0.5">
          Petugas Aktif: <strong class="text-stone-800">Nazhat Hafidz Al Jauzi</strong> &middot; Urutan FIFO &amp; CRUD PostgreSQL
        </p>
      </div>
    </div>

    <!-- Tab Pilihan: [ Antrean Masak (KDS) ] vs [ Kelola Menu & Stok (CRUD) ] -->
    <div class="flex items-center gap-2">
      <div class="grid grid-cols-2 gap-1 bg-stone-100 p-1 rounded-xl text-xs font-bold">
        <button
          type="button"
          id="tab-kds-antrean"
          class="py-2 px-3.5 rounded-lg transition-all cursor-pointer bg-white text-stone-900 shadow-xs"
        >
          Antrean (<span id="stat-antrean-aktif"><%= antreanAktif.length %></span>)
        </button>
        <button
          type="button"
          id="tab-kds-stok"
          class="py-2 px-3.5 rounded-lg transition-all cursor-pointer text-stone-600 hover:text-stone-900"
        >
          Kelola Menu &amp; Stok (<span id="stat-total-menu"><%= semuaMenu.length %></span>)
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Notifikasi Ringkas -->
  <div
    id="toast-staf"
    class="hidden fixed top-20 right-5 z-50 bg-stone-900 text-white px-5 py-3 rounded-2xl shadow-xl text-xs sm:text-sm font-semibold flex items-center gap-2"
  ></div>

  <!-- ========================================================================= -->
  <!-- VIEW 1: ANTREAN DAPUR TIKET BESAR (MUDAH DILIHAT DARI JAUH SAMBIL MASAK) -->
  <!-- ========================================================================= -->
  <section id="panel-antrean-masak" class="space-y-4">
    
    <!-- Grid Tiket Pesanan Masak (Besar & Jelas) -->
    <div id="kontainer-antrean-fifo" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
      <% if (antreanAktif.length === 0) { %>
        <div class="col-span-full py-16 text-center border-2 border-dashed border-stone-200 bg-white rounded-3xl text-stone-400">
          <p class="text-base font-bold text-stone-600">Dapur Sedang Kosong</p>
          <p class="text-xs text-stone-400 mt-1">Belum ada pesanan baru dari meja pelanggan.</p>
        </div>
      <% } %>

      <% antreanAktif.forEach(function(pesanan) { %>
        <% const sedangMasak = pesanan.status === 'Sedang Diproses'; %>
        <article
          class="bg-white rounded-3xl border-2 shadow-xs flex flex-col justify-between overflow-hidden transition-all <%= sedangMasak ? 'border-amber-500 ring-2 ring-amber-100' : 'border-stone-200' %>"
          data-order-kode="<%= pesanan.nomorAntrean %>"
        >
          <!-- Bagian Atas: Nomor Meja & Nomor Antrean JUMBO -->
          <div class="p-5 border-b border-stone-100 <%= sedangMasak ? 'bg-amber-50/50' : 'bg-stone-50/50' %>">
            <div class="flex items-center justify-between">
              <span class="text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight">
                MEJA <%= pesanan.nomorMeja %>
              </span>
              <span class="px-3 py-1 rounded-xl font-mono text-xs font-bold <%= sedangMasak ? 'bg-amber-200 text-amber-950' : 'bg-stone-200 text-stone-800' %>">
                <%= pesanan.nomorAntrean %>
              </span>
            </div>

            <div class="flex items-center justify-between text-xs text-stone-500 mt-2 font-medium">
              <span>Pemesan: <strong><%= pesanan.namaPelanggan %></strong></span>
              <span class="font-mono bg-white px-2 py-0.5 rounded border border-stone-200 text-stone-700">
                <%= hitungWaktuTunggu(pesanan.waktuPesan) %>
              </span>
            </div>
          </div>

          <!-- Rincian Menu Pesanan Tulisan Tebal & Mudah Dibaca -->
          <div class="p-5 flex-1 space-y-3">
            <ul class="space-y-2.5">
              <% pesanan.items.forEach(function(item) { %>
                <li class="flex items-center justify-between gap-3 text-sm sm:text-base border-b border-dashed border-stone-100 pb-2">
                  <span class="font-bold text-stone-900 leading-tight">
                    <%= item.nama %>
                  </span>
                  <span class="text-lg font-extrabold text-stone-900 bg-stone-100 px-3 py-0.5 rounded-lg shrink-0">
                    <%= item.qty %>x
                  </span>
                </li>
              <% }); %>
            </ul>

            <!-- Catatan Khusus Dari Pelanggan -->
            <% if (pesanan.catatan && pesanan.catatan !== '-') { %>
              <div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 mt-2">
                <strong>Catatan Khusus:</strong> <%= pesanan.catatan %>
              </div>
            <% } %>
          </div>

          <!-- Tombol Aksi Sentuh Super Besar (Kitchen Friendly) -->
          <div class="p-4 bg-stone-50 border-t border-stone-100 flex items-center gap-2">
            <% if (pesanan.status === 'Menunggu Konfirmasi') { %>
              <button
                type="button"
                data-aksi-status="Sedang Diproses"
                data-kode="<%= pesanan.nomorAntrean %>"
                class="flex-1 py-3.5 px-4 bg-amber-600 hover:bg-amber-700 active:scale-95 text-white font-bold text-sm rounded-xl transition-all shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"
              >
                <span>🔥 Mulai Masak</span>
              </button>
            <% } %>

            <button
              type="button"
              data-aksi-status="Siap Diantar"
              data-kode="<%= pesanan.nomorAntrean %>"
              class="flex-1 py-3.5 px-4 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold text-sm rounded-xl transition-all shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span>✅ Siap Diantar</span>
            </button>
          </div>
        </article>
      <% }); %>
    </div>

    <!-- Riwayat Selesai Ringkas di Bawah Antrean -->
    <div class="bg-white rounded-3xl border border-stone-200/90 p-5 shadow-xs space-y-3">
      <div class="flex items-center justify-between border-b border-stone-100 pb-3">
        <h3 class="text-sm font-bold text-stone-900">
          Pesanan yang Baru Selesai Diantar
        </h3>
        <span id="badge-total-selesai" class="text-xs font-bold text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-lg">
          <%= riwayatSelesai.length %> Selesai
        </span>
      </div>

      <div id="kontainer-riwayat-selesai" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5">
        <% riwayatSelesai.slice(0, 6).forEach(function(p) { %>
          <div class="p-3 rounded-xl bg-stone-50 border border-stone-200 flex items-center justify-between text-xs">
            <div>
              <span class="font-bold text-stone-900">Meja <%= p.nomorMeja %></span> &middot; <span class="font-mono text-stone-500"><%= p.nomorAntrean %></span>
              <p class="text-[11px] text-stone-500 truncate max-w-xs mt-0.5">
                <%= p.items.map(i => `${i.qty}x ${i.nama}`).join(', ') %>
              </p>
            </div>
            <span class="text-emerald-700 font-bold text-[11px] bg-emerald-50 px-2 py-0.5 rounded">Selesai</span>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- VIEW 2: MANAJEMEN MENU & STOK (CRUD LENGKAP KE POSTGRESQL VIA SEQUELIZE) -->
  <!-- ========================================================================= -->
  <section id="panel-kelola-stok" class="hidden space-y-5">

    <!-- Form Tambah Menu Baru (POST /api/produk) -->
    <div class="bg-white rounded-3xl border border-stone-200/90 p-5 sm:p-6 shadow-xs space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-100 pb-3">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-stone-900">
            Tambah Menu / Produk Baru ke Database
          </h2>
          <p class="text-xs text-stone-500 mt-0.5">
            Menyimpan menu baru secara permanen ke tabel <code>menus</code> di PostgreSQL (<code>POST /api/produk</code>).
          </p>
        </div>
      </div>

      <form id="form-tambah-menu" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 items-end">
        <div class="lg:col-span-2">
          <label class="block text-[11px] font-bold text-stone-700 mb-1">Nama Menu *</label>
          <input
            type="text"
            id="tambah-nama"
            required
            placeholder="Contoh: Kopi Tubruk Gayo"
            class="w-full px-3.5 py-2 text-xs bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold text-stone-700 mb-1">Kategori</label>
          <select
            id="tambah-kategori"
            class="w-full px-3 py-2 text-xs bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900"
          >
            <% kategoriList.forEach(function(kat) { %>
              <option value="<%= kat %>"><%= kat %></option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="block text-[11px] font-bold text-stone-700 mb-1">Harga (Rp) *</label>
          <input
            type="number"
            id="tambah-harga"
            required
            min="1000"
            step="500"
            value="25000"
            class="w-full px-3 py-2 text-xs bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold text-stone-700 mb-1">Stok Awal (Porsi) *</label>
          <input
            type="number"
            id="tambah-stok"
            required
            min="0"
            max="500"
            value="25"
            class="w-full px-3 py-2 text-xs bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900"
          />
        </div>

        <div>
          <button
            type="submit"
            class="w-full py-2 px-4 bg-stone-900 hover:bg-stone-800 text-white text-xs font-bold rounded-xl transition-all cursor-pointer shadow-xs"
          >
            + Tambah Menu
          </button>
        </div>

        <div class="sm:col-span-2 lg:col-span-4">
          <label class="block text-[11px] font-bold text-stone-700 mb-1">Deskripsi Singkat Menu</label>
          <input
            type="text"
            id="tambah-deskripsi"
            placeholder="Deskripsi bahan dan cita rasa menu..."
            class="w-full px-3.5 py-2 text-xs bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900"
          />
        </div>

        <div class="sm:col-span-2 lg:col-span-2">
          <label class="block text-[11px] font-bold text-stone-700 mb-1">URL Gambar Menu (Opsional)</label>
          <input
            type="url"
            id="tambah-gambar"
            placeholder="https://images.unsplash.com/..."
            class="w-full px-3.5 py-2 text-xs bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900"
          />
        </div>
      </form>
    </div>

    <!-- Daftar & Kontrol Cepat Stok Menu (Update & Delete Database) -->
    <div class="bg-white rounded-3xl border border-stone-200/90 p-5 sm:p-6 shadow-xs space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-100 pb-4">
        <div>
          <h2 class="text-lg font-bold text-stone-900">
            Daftar Menu &amp; Kendali Stok Dapur
          </h2>
          <p class="text-xs text-stone-500 mt-0.5">
            Ubah stok 1-klik, klik <strong>Edit</strong> untuk memperbarui detail menu (<code>PUT /api/produk/:id</code>), atau <strong>Hapus</strong> (<code>DELETE /api/produk/:id</code>).
          </p>
        </div>
      </div>

      <!-- Grid Kartu Menu Dapur -->
      <div id="grid-stok-staf" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% semuaMenu.forEach(function(item) { %>
          <div
            id="row-stok-<%= item.id %>"
            class="p-4 rounded-2xl border transition-all flex flex-col justify-between <%= item.stok === 0 ? 'bg-red-50/50 border-red-200' : 'bg-stone-50 border-stone-200/90' %>"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-1.5">
                <span class="text-[11px] font-semibold text-stone-500"><%= item.kode %> &middot; <%= item.kategori %></span>
                <span
                  id="status-pill-<%= item.id %>"
                  class="font-mono text-xs font-bold px-2 py-0.5 rounded-md <%= item.stok === 0 ? 'bg-red-600 text-white' : (item.stokMenipis ? 'bg-amber-100 text-amber-900' : 'bg-emerald-100 text-emerald-900') %>"
                >
                  <%= item.stok === 0 ? 'Habis (0)' : `Sisa ${item.stok}` %>
                </span>
              </div>
              <h3 class="font-bold text-base text-stone-900 leading-snug">
                <%= item.nama %>
              </h3>
              <p class="text-xs font-semibold text-stone-700 mt-0.5">
                <%= formatRupiah(item.harga) %>
              </p>
              <p class="text-[11px] text-stone-500 line-clamp-2 mt-1">
                <%= item.deskripsi %>
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-stone-200/70 space-y-2.5">
              <div class="flex items-center justify-between gap-2">
                <!-- Input Cepat Kuota Porsi -->
                <div class="flex items-center gap-1.5">
                  <input
                    id="input-stok-<%= item.id %>"
                    type="number"
                    min="0"
                    max="500"
                    value="<%= item.stok %>"
                    class="w-16 px-2 py-1.5 font-bold text-xs bg-white border border-stone-300 rounded-lg text-center"
                  />
                  <button
                    type="button"
                    data-simpan-stok="<%= item.id %>"
                    class="px-2.5 py-1.5 bg-stone-900 text-white text-xs font-semibold rounded-lg hover:bg-stone-800 cursor-pointer"
                  >
                    Stok
                  </button>
                </div>

                <!-- Tombol 1-Klik Tandai Habis / Pulihkan -->
                <button
                  type="button"
                  id="btn-toggle-habis-<%= item.id %>"
                  data-toggle-habis="<%= item.id %>"
                  class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer <%= item.stok === 0 ? 'bg-emerald-600 hover:bg-emerald-700 text-white' : 'bg-red-600 hover:bg-red-700 text-white' %>"
                >
                  <%= item.stok === 0 ? 'Aktifkan (15)' : 'Kunci Habis' %>
                </button>
              </div>

              <!-- Baris Tombol CRUD: Edit (PUT) & Hapus (DELETE) -->
              <div class="flex items-center justify-end gap-2 pt-1 border-t border-stone-200/50">
                <button
                  type="button"
                  data-edit-menu="<%= item.id %>"
                  data-nama="<%= item.nama %>"
                  data-kategori="<%= item.kategori %>"
                  data-harga="<%= item.harga %>"
                  data-stok="<%= item.stok %>"
                  data-deskripsi="<%= item.deskripsi %>"
                  data-gambar="<%= item.gambar %>"
                  class="px-2.5 py-1 rounded-lg bg-white border border-stone-300 hover:bg-stone-100 text-stone-700 text-[11px] font-semibold cursor-pointer"
                >
                  ✏️ Edit Menu
                </button>
                <button
                  type="button"
                  data-hapus-menu="<%= item.id %>"
                  data-nama="<%= item.nama %>"
                  class="px-2.5 py-1 rounded-lg bg-white border border-red-200 hover:bg-red-50 text-red-600 text-[11px] font-semibold cursor-pointer"
                >
                  🗑️ Hapus
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

</main>

<!-- Modal Edit Menu (PUT /api/produk/:id) -->
<div
  id="modal-edit-menu"
  class="hidden fixed inset-0 z-50 bg-stone-950/50 backdrop-blur-xs flex items-center justify-center p-4"
>
  <div class="bg-white w-full max-w-md rounded-3xl border border-stone-200 shadow-2xl overflow-hidden">
    <div class="px-5 py-4 bg-stone-900 text-white flex items-center justify-between">
      <div>
        <h3 class="text-sm font-bold">Edit Data Menu (PUT /api/produk/:id)</h3>
        <p class="text-[11px] text-stone-300">Perubahan langsung tersimpan ke PostgreSQL</p>
      </div>
      <button type="button" id="btn-tutup-modal-edit" class="text-stone-300 hover:text-white text-sm font-bold cursor-pointer">
        ✕
      </button>
    </div>

    <form id="form-edit-menu" class="p-5 space-y-3.5">
      <input type="hidden" id="edit-id" />

      <div>
        <label class="block text-xs font-bold text-stone-700 mb-1">Nama Menu *</label>
        <input
          type="text"
          id="edit-nama"
          required
          class="w-full px-3.5 py-2 text-xs bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900"
        />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-stone-700 mb-1">Kategori</label>
          <select
            id="edit-kategori"
            class="w-full px-3 py-2 text-xs bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900"
          >
            <% kategoriList.forEach(function(kat) { %>
              <option value="<%= kat %>"><%= kat %></option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-stone-700 mb-1">Harga (Rp) *</label>
          <input
            type="number"
            id="edit-harga"
            required
            min="1000"
            class="w-full px-3 py-2 text-xs bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-stone-700 mb-1">Sisa Stok (Porsi) *</label>
        <input
          type="number"
          id="edit-stok"
          required
          min="0"
          class="w-full px-3.5 py-2 text-xs bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900"
        />
      </div>

      <div>
        <label class="block text-xs font-bold text-stone-700 mb-1">Deskripsi</label>
        <textarea
          id="edit-deskripsi"
          rows="2"
          class="w-full px-3.5 py-2 text-xs bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900"
        ></textarea>
      </div>

      <div>
        <label class="block text-xs font-bold text-stone-700 mb-1">URL Gambar</label>
        <input
          type="url"
          id="edit-gambar"
          class="w-full px-3.5 py-2 text-xs bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900"
        />
      </div>

      <div class="pt-2 flex items-center justify-end gap-2">
        <button
          type="button"
          id="btn-batal-edit"
          class="px-4 py-2 rounded-xl border border-stone-300 text-stone-700 text-xs font-semibold hover:bg-stone-100 cursor-pointer"
        >
          Batal
        </button>
        <button
          type="submit"
          class="px-4 py-2 rounded-xl bg-stone-900 hover:bg-stone-800 text-white text-xs font-bold cursor-pointer"
        >
          Simpan Perubahan
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer', { appConfig }) %>

<script>
  (function () {
    'use strict';

    const tabAntrean = document.getElementById('tab-kds-antrean');
    const tabStok = document.getElementById('tab-kds-stok');
    const panelAntrean = document.getElementById('panel-antrean-masak');
    const panelStok = document.getElementById('panel-kelola-stok');

    const toastEl = document.getElementById('toast-staf');
    const kontainerAntrean = document.getElementById('kontainer-antrean-fifo');
    const kontainerRiwayat = document.getElementById('kontainer-riwayat-selesai');
    const gridStokStaf = document.getElementById('grid-stok-staf');
    const statAntreanAktif = document.getElementById('stat-antrean-aktif');
    const statTotalMenu = document.getElementById('stat-total-menu');
    const badgeTotalSelesai = document.getElementById('badge-total-selesai');

    // Elemen CRUD Form & Modal
    const formTambahMenu = document.getElementById('form-tambah-menu');
    const modalEditMenu = document.getElementById('modal-edit-menu');
    const formEditMenu = document.getElementById('form-edit-menu');
    const btnTutupModalEdit = document.getElementById('btn-tutup-modal-edit');
    const btnBatalEdit = document.getElementById('btn-batal-edit');

    let jumlahAntreanTerakhir = Number('<%= antreanAktif.length %>') || 0;

    function formatRupiahClient(angka) {
      return 'Rp ' + (Number(angka) || 0).toLocaleString('id-ID');
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // Tab Switcher Dapur
    tabAntrean.addEventListener('click', () => {
      tabAntrean.className = 'py-2 px-3.5 rounded-lg transition-all cursor-pointer bg-white text-stone-900 shadow-xs font-bold';
      tabStok.className = 'py-2 px-3.5 rounded-lg transition-all cursor-pointer text-stone-600 hover:text-stone-900 font-bold';
      panelAntrean.classList.remove('hidden');
      panelStok.classList.add('hidden');
    });

    tabStok.addEventListener('click', () => {
      tabStok.className = 'py-2 px-3.5 rounded-lg transition-all cursor-pointer bg-white text-stone-900 shadow-xs font-bold';
      tabAntrean.className = 'py-2 px-3.5 rounded-lg transition-all cursor-pointer text-stone-600 hover:text-stone-900 font-bold';
      panelStok.classList.remove('hidden');
      panelAntrean.classList.add('hidden');
    });

    function bunyikanNotifikasiDapur() {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.25);
      } catch (e) {}
    }

    let toastTimer;
    function tampilkanToast(pesan) {
      clearTimeout(toastTimer);
      toastEl.textContent = pesan;
      toastEl.classList.remove('hidden');
      toastTimer = setTimeout(() => {
        toastEl.classList.add('hidden');
      }, 3000);
    }

    // 1. CREATE: Tambah Menu Baru (POST /api/produk)
    formTambahMenu.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        nama: document.getElementById('tambah-nama').value.trim(),
        kategori: document.getElementById('tambah-kategori').value,
        harga: Number(document.getElementById('tambah-harga').value),
        stok: Number(document.getElementById('tambah-stok').value),
        deskripsi: document.getElementById('tambah-deskripsi').value.trim(),
        gambar: document.getElementById('tambah-gambar').value.trim()
      };

      const res = await fetch('/api/produk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.sukses) {
        tampilkanToast(data.pesan);
        formTambahMenu.reset();
        document.getElementById('tambah-harga').value = 25000;
        document.getElementById('tambah-stok').value = 25;
        if (Array.isArray(data.semuaMenu)) {
          renderGridMenuStaf(data.semuaMenu);
        } else {
          muatSinkronisasiDapur();
        }
      } else {
        tampilkanToast(data.pesanError || 'Gagal menambahkan menu.');
      }
    });

    // 2. UPDATE: Simpan Edit Menu (PUT /api/produk/:id)
    function tutupModalEdit() {
      modalEditMenu.classList.add('hidden');
    }
    btnTutupModalEdit.addEventListener('click', tutupModalEdit);
    btnBatalEdit.addEventListener('click', tutupModalEdit);

    formEditMenu.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = document.getElementById('edit-id').value;
      const payload = {
        nama: document.getElementById('edit-nama').value.trim(),
        kategori: document.getElementById('edit-kategori').value,
        harga: Number(document.getElementById('edit-harga').value),
        stok: Number(document.getElementById('edit-stok').value),
        deskripsi: document.getElementById('edit-deskripsi').value.trim(),
        gambar: document.getElementById('edit-gambar').value.trim()
      };

      const res = await fetch(`/api/produk/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.sukses) {
        tampilkanToast(data.pesan);
        tutupModalEdit();
        if (Array.isArray(data.semuaMenu)) {
          renderGridMenuStaf(data.semuaMenu);
        } else {
          muatSinkronisasiDapur();
        }
      } else {
        tampilkanToast(data.pesanError || 'Gagal memperbarui menu.');
      }
    });

    // Aksi Klik Status Dapur (Mulai Masak / Siap Diantar)
    kontainerAntrean.addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-aksi-status]');
      if (!btn) return;

      const kode = btn.getAttribute('data-kode');
      const statusBaru = btn.getAttribute('data-aksi-status');

      const res = await fetch(`/api/pesanan/${kode}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: statusBaru })
      });
      const data = await res.json();
      if (data.sukses) {
        tampilkanToast(data.pesan);
        muatSinkronisasiDapur();
      }
    });

    // Aksi Kendali Stok, Edit (PUT), dan Hapus (DELETE)
    gridStokStaf.addEventListener('click', async (e) => {
      const btnSimpan = e.target.closest('[data-simpan-stok]');
      const btnToggle = e.target.closest('[data-toggle-habis]');
      const btnEdit = e.target.closest('[data-edit-menu]');
      const btnHapus = e.target.closest('[data-hapus-menu]');

      if (btnSimpan) {
        const menuId = btnSimpan.getAttribute('data-simpan-stok');
        const inputEl = document.getElementById(`input-stok-${menuId}`);
        const nilaiStok = Number(inputEl.value);

        const res = await fetch(`/api/produk/${menuId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ stok: nilaiStok })
        });
        const data = await res.json();
        if (data.sukses) {
          tampilkanToast(data.pesan);
          if (Array.isArray(data.semuaMenu)) renderGridMenuStaf(data.semuaMenu);
        }
      }

      if (btnToggle) {
        const menuId = btnToggle.getAttribute('data-toggle-habis');
        const res = await fetch(`/api/stok/${menuId}/toggle-habis`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.sukses) {
          tampilkanToast(data.pesan);
          if (Array.isArray(data.semuaMenu)) renderGridMenuStaf(data.semuaMenu);
        }
      }

      if (btnEdit) {
        document.getElementById('edit-id').value = btnEdit.getAttribute('data-edit-menu');
        document.getElementById('edit-nama').value = btnEdit.getAttribute('data-nama') || '';
        document.getElementById('edit-kategori').value = btnEdit.getAttribute('data-kategori') || 'Hidangan Utama';
        document.getElementById('edit-harga').value = btnEdit.getAttribute('data-harga') || 20000;
        document.getElementById('edit-stok').value = btnEdit.getAttribute('data-stok') || 0;
        document.getElementById('edit-deskripsi').value = btnEdit.getAttribute('data-deskripsi') || '';
        document.getElementById('edit-gambar').value = btnEdit.getAttribute('data-gambar') || '';
        modalEditMenu.classList.remove('hidden');
      }

      if (btnHapus) {
        const menuId = btnHapus.getAttribute('data-hapus-menu');
        const namaMenu = btnHapus.getAttribute('data-nama');
        if (!confirm(`Yakin ingin menghapus menu "${namaMenu}" dari database?`)) return;

        const res = await fetch(`/api/produk/${menuId}`, {
          method: 'DELETE'
        });
        const data = await res.json();
        if (data.sukses) {
          tampilkanToast(data.pesan);
          if (Array.isArray(data.semuaMenu)) renderGridMenuStaf(data.semuaMenu);
        } else {
          tampilkanToast(data.pesanError || 'Gagal menghapus menu.');
        }
      }
    });

    function renderGridMenuStaf(daftarMenu) {
      statTotalMenu.textContent = daftarMenu.length;
      gridStokStaf.innerHTML = daftarMenu.map((item) => {
        const isHabis = item.stok === 0;
        const pillClass = isHabis
          ? 'bg-red-600 text-white'
          : (item.stokMenipis ? 'bg-amber-100 text-amber-900' : 'bg-emerald-100 text-emerald-900');

        return `
          <div
            id="row-stok-${item.id}"
            class="p-4 rounded-2xl border transition-all flex flex-col justify-between ${isHabis ? 'bg-red-50/50 border-red-200' : 'bg-stone-50 border-stone-200/90'}"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-1.5">
                <span class="text-[11px] font-semibold text-stone-500">${escapeHtml(item.kode)} &middot; ${escapeHtml(item.kategori)}</span>
                <span
                  id="status-pill-${item.id}"
                  class="font-mono text-xs font-bold px-2 py-0.5 rounded-md ${pillClass}"
                >
                  ${isHabis ? 'Habis (0)' : `Sisa ${item.stok}`}
                </span>
              </div>
              <h3 class="font-bold text-base text-stone-900 leading-snug">
                ${escapeHtml(item.nama)}
              </h3>
              <p class="text-xs font-semibold text-stone-700 mt-0.5">
                ${formatRupiahClient(item.harga)}
              </p>
              <p class="text-[11px] text-stone-500 line-clamp-2 mt-1">
                ${escapeHtml(item.deskripsi)}
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-stone-200/70 space-y-2.5">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-1.5">
                  <input
                    id="input-stok-${item.id}"
                    type="number"
                    min="0"
                    max="500"
                    value="${item.stok}"
                    class="w-16 px-2 py-1.5 font-bold text-xs bg-white border border-stone-300 rounded-lg text-center"
                  />
                  <button
                    type="button"
                    data-simpan-stok="${item.id}"
                    class="px-2.5 py-1.5 bg-stone-900 text-white text-xs font-semibold rounded-lg hover:bg-stone-800 cursor-pointer"
                  >
                    Stok
                  </button>
                </div>

                <button
                  type="button"
                  id="btn-toggle-habis-${item.id}"
                  data-toggle-habis="${item.id}"
                  class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer ${isHabis ? 'bg-emerald-600 hover:bg-emerald-700 text-white' : 'bg-red-600 hover:bg-red-700 text-white'}"
                >
                  ${isHabis ? 'Aktifkan (15)' : 'Kunci Habis'}
                </button>
              </div>

              <div class="flex items-center justify-end gap-2 pt-1 border-t border-stone-200/50">
                <button
                  type="button"
                  data-edit-menu="${item.id}"
                  data-nama="${escapeHtml(item.nama)}"
                  data-kategori="${escapeHtml(item.kategori)}"
                  data-harga="${item.harga}"
                  data-stok="${item.stok}"
                  data-deskripsi="${escapeHtml(item.deskripsi)}"
                  data-gambar="${escapeHtml(item.gambar)}"
                  class="px-2.5 py-1 rounded-lg bg-white border border-stone-300 hover:bg-stone-100 text-stone-700 text-[11px] font-semibold cursor-pointer"
                >
                  ✏️ Edit Menu
                </button>
                <button
                  type="button"
                  data-hapus-menu="${item.id}"
                  data-nama="${escapeHtml(item.nama)}"
                  class="px-2.5 py-1 rounded-lg bg-white border border-red-200 hover:bg-red-50 text-red-600 text-[11px] font-semibold cursor-pointer"
                >
                  🗑️ Hapus
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    async function muatSinkronisasiDapur() {
      try {
        const res = await fetch('/api/sinkronisasi', { cache: 'no-store' });
        if (!res.ok) return;
        const data = await res.json();

        if (Array.isArray(data.antreanAktif)) {
          if (data.antreanAktif.length > jumlahAntreanTerakhir) {
            bunyikanNotifikasiDapur();
            tampilkanToast(`🔔 Pesanan Baru Masuk untuk Meja ${data.antreanAktif[data.antreanAktif.length - 1].nomorMeja}!`);
          }
          jumlahAntreanTerakhir = data.antreanAktif.length;
          statAntreanAktif.textContent = data.antreanAktif.length;
          renderAntreanFIFO(data.antreanAktif);
        }

        if (Array.isArray(data.semuaMenu)) {
          statTotalMenu.textContent = data.semuaMenu.length;
        }

        if (Array.isArray(data.riwayatSelesai)) {
          badgeTotalSelesai.textContent = `${data.riwayatSelesai.length} Selesai`;
          renderRiwayatSelesai(data.riwayatSelesai);
        }
      } catch (err) {}
    }

    function renderAntreanFIFO(antrean) {
      if (antrean.length === 0) {
        kontainerAntrean.innerHTML = `
          <div class="col-span-full py-16 text-center border-2 border-dashed border-stone-200 bg-white rounded-3xl text-stone-400">
            <p class="text-base font-bold text-stone-600">Dapur Sedang Kosong</p>
            <p class="text-xs text-stone-400 mt-1">Belum ada pesanan baru dari meja pelanggan.</p>
          </div>
        `;
        return;
      }

      kontainerAntrean.innerHTML = antrean.map((pesanan) => {
        const sedangMasak = pesanan.status === 'Sedang Diproses';
        const listItems = pesanan.items.map(i => `
          <li class="flex items-center justify-between gap-3 text-sm sm:text-base border-b border-dashed border-stone-100 pb-2">
            <span class="font-bold text-stone-900 leading-tight">${escapeHtml(i.nama)}</span>
            <span class="text-lg font-extrabold text-stone-900 bg-stone-100 px-3 py-0.5 rounded-lg shrink-0">${i.qty}x</span>
          </li>
        `).join('');

        return `
          <article class="bg-white rounded-3xl border-2 shadow-xs flex flex-col justify-between overflow-hidden transition-all ${sedangMasak ? 'border-amber-500 ring-2 ring-amber-100' : 'border-stone-200'}" data-order-kode="${pesanan.nomorAntrean}">
            <div class="p-5 border-b border-stone-100 ${sedangMasak ? 'bg-amber-50/50' : 'bg-stone-50/50'}">
              <div class="flex items-center justify-between">
                <span class="text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight">MEJA ${escapeHtml(pesanan.nomorMeja)}</span>
                <span class="px-3 py-1 rounded-xl font-mono text-xs font-bold ${sedangMasak ? 'bg-amber-200 text-amber-950' : 'bg-stone-200 text-stone-800'}">${escapeHtml(pesanan.nomorAntrean)}</span>
              </div>
              <div class="flex items-center justify-between text-xs text-stone-500 mt-2 font-medium">
                <span>Pemesan: <strong>${escapeHtml(pesanan.namaPelanggan)}</strong></span>
                <span class="font-mono bg-white px-2 py-0.5 rounded border border-stone-200 text-stone-700">${escapeHtml(pesanan.labelWaktuTunggu || 'Baru masuk')}</span>
              </div>
            </div>

            <div class="p-5 flex-1 space-y-3">
              <ul class="space-y-2.5">${listItems}</ul>
              ${pesanan.catatan && pesanan.catatan !== '-' ? `<div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 mt-2"><strong>Catatan Khusus:</strong> ${escapeHtml(pesanan.catatan)}</div>` : ''}
            </div>

            <div class="p-4 bg-stone-50 border-t border-stone-100 flex items-center gap-2">
              ${pesanan.status === 'Menunggu Konfirmasi' ? `<button type="button" data-aksi-status="Sedang Diproses" data-kode="${escapeHtml(pesanan.nomorAntrean)}" class="flex-1 py-3.5 px-4 bg-amber-600 hover:bg-amber-700 active:scale-95 text-white font-bold text-sm rounded-xl transition-all shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"><span>🔥 Mulai Masak</span></button>` : ''}
              <button type="button" data-aksi-status="Siap Diantar" data-kode="${escapeHtml(pesanan.nomorAntrean)}" class="flex-1 py-3.5 px-4 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold text-sm rounded-xl transition-all shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"><span>✅ Siap Diantar</span></button>
            </div>
          </article>
        `;
      }).join('');
    }

    function renderRiwayatSelesai(riwayat) {
      kontainerRiwayat.innerHTML = riwayat.slice(0, 6).map(p => `
        <div class="p-3 rounded-xl bg-stone-50 border border-stone-200 flex items-center justify-between text-xs">
          <div>
            <span class="font-bold text-stone-900">Meja ${escapeHtml(p.nomorMeja)}</span> &middot; <span class="font-mono text-stone-500">${escapeHtml(p.nomorAntrean)}</span>
            <p class="text-[11px] text-stone-500 truncate max-w-xs mt-0.5">${p.items.map(i => `${i.qty}x ${escapeHtml(i.nama)}`).join(', ')}</p>
          </div>
          <span class="text-emerald-700 font-bold text-[11px] bg-emerald-50 px-2 py-0.5 rounded">Selesai</span>
        </div>
      `).join('');
    }

    setInterval(muatSinkronisasiDapur, 3000);
  })();
</script>
</body>
</html>
