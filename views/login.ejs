<%#
  ============================================================================
  FILE: views/login.ejs
  ============================================================================
  FUNGSI:
  Halaman khusus Check-In Meja Pelanggan (Scope A - Evan Vijaya Putra).
  Terpisah sepenuhnya dari halaman login Staf Dapur & Pemilik agar pelanggan
  yang melakukan Scan QR Code di meja memiliki pengalaman pemesanan yang
  bersih, hangat, dan tidak melihat akses manajemen internal kedai.
%>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Selamat Datang Pelanggan — <%= appConfig.appName %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif']
          }
        }
      }
    };
  </script>
</head>
<body class="relative bg-stone-950 text-stone-900 font-sans min-h-screen flex flex-col justify-between antialiased selection:bg-amber-800 selection:text-white overflow-x-hidden">

  <!-- Background Foto Suasana Toko Kopi Simpanan Fullscreen -->
  <div class="fixed inset-0 -z-10">
    <img
      src="https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=1920&q=85"
      alt="Interior Toko Kopi Simpanan"
      class="w-full h-full object-cover scale-105 filter brightness-[0.42] contrast-105"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-stone-950/70 via-stone-950/45 to-stone-950/85"></div>
  </div>

  <!-- Navbar Sederhana Pelanggan (Responsif Mobile) -->
  <header class="w-full max-w-4xl mx-auto px-4 sm:px-5 pt-5 pb-2 flex items-center justify-between gap-2">
    <div class="flex items-center gap-2.5 min-w-0">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-amber-600 to-stone-900 border border-amber-400/40 text-amber-100 flex items-center justify-center shadow-md shrink-0">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 8h1a4 4 0 1 1 0 8h-1"/>
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/>
          <line x1="6" y1="2" x2="6" y2="4"/>
          <line x1="10" y1="2" x2="10" y2="4"/>
          <line x1="14" y1="2" x2="14" y2="4"/>
        </svg>
      </div>
      <div class="min-w-0">
        <span class="font-bold text-sm sm:text-base text-white block leading-tight truncate drop-shadow-xs"><%= appConfig.appName %></span>
        <span class="text-[11px] sm:text-xs text-amber-200/90 block mt-0.5 truncate">Signature Roastery &amp; Dine-In</span>
      </div>
    </div>
    <div class="text-right shrink-0">
      <% const sedangBuka = typeof statusToko !== 'undefined' ? statusToko.sedangBuka : true; %>
      <span
        id="badge-header-toko"
        class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full border text-[10px] sm:text-[11px] font-semibold shadow-xs <%= sedangBuka ? 'bg-emerald-50/95 border-emerald-200 text-emerald-900' : 'bg-red-50/95 border-red-200 text-red-900' %>"
      >
        <span id="dot-header-toko" class="w-1.5 h-1.5 rounded-full shrink-0 <%= sedangBuka ? 'bg-emerald-500 animate-pulse' : 'bg-red-600' %>"></span>
        <span id="teks-header-toko"><%= sedangBuka ? 'Buka' : 'Tutup' %><span class="hidden sm:inline"> &middot; <%= appConfig.jamOperasional %></span></span>
      </span>
    </div>
  </header>

  <!-- Konten Utama: Kartu Check-In Meja Pelanggan -->
  <main class="flex-1 flex items-center justify-center px-3.5 sm:px-4 py-4 sm:py-6">
    <div class="w-full max-w-md bg-white/95 backdrop-blur-md rounded-3xl border border-white/20 shadow-2xl overflow-hidden">

      <!-- Banner Visual Kuliner & Kopi Hangat -->
      <div class="relative h-28 sm:h-36 bg-stone-900 overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=900&q=80"
          alt="Suasana Kedai Kopi"
          class="w-full h-full object-cover opacity-45"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-stone-950/90 via-stone-950/40 to-transparent p-5 sm:p-6 flex flex-col justify-end">
          <span class="inline-block w-fit text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-md bg-amber-500/20 text-amber-300 border border-amber-400/30 mb-1">
            QR Table Order
          </span>
          <h1 class="text-base sm:text-xl font-bold text-white leading-tight">
            Pesan Langsung dari Meja Anda
          </h1>
        </div>
      </div>

      <div class="p-5 sm:p-7">
        <!-- Alert Error Validasi Jika Ada -->
        <% if (pesanError) { %>
          <div id="alert-pesan-error" class="mb-5 rounded-2xl bg-red-50 border border-red-200 px-4 py-3 text-xs text-red-800 font-medium">
            <%= pesanError %>
          </div>
        <% } %>

        <div
          id="box-toko-tutup"
          class="<%= (typeof statusToko !== 'undefined' && !statusToko.sedangBuka) ? '' : 'hidden' %> mb-5 rounded-2xl bg-amber-50 border border-amber-300 p-4 text-xs text-amber-950 space-y-1"
        >
          <p class="font-bold text-sm text-amber-900">🔒 Penerimaan Pesanan Baru Sedang Ditutup</p>
          <p id="alasan-toko-tutup" class="leading-relaxed"><%= typeof statusToko !== 'undefined' ? statusToko.alasan : '' %></p>
          <p class="text-[11px] font-semibold text-amber-800 pt-1">Anda tetap dapat masuk ke meja untuk memantau status pesanan yang sedang dimasak.</p>
        </div>

        <p class="text-xs text-stone-500 leading-relaxed mb-5">
          Silakan isi nama Anda dan pilih nomor meja tempat Anda duduk saat ini untuk melihat daftar menu, stok real-time, serta bertanya pada Asisten Barista AI kami.
        </p>

        <form action="/auth/login-pelanggan" method="POST" class="space-y-4">
          <div>
            <label for="namaPelanggan" class="block text-xs font-semibold text-stone-700 mb-1.5">
              Nama Pemesan
            </label>
            <input
              id="namaPelanggan"
              name="namaPelanggan"
              type="text"
              required
              minlength="2"
              maxlength="60"
              pattern="^[A-Za-z\s.'\-]+$"
              title="Nama pemesan hanya boleh menggunakan huruf dan spasi (tanpa angka atau simbol)"
              oninput="this.value = this.value.replace(/[0-9]/g, '')"
              autofocus
              value=""
              placeholder="Masukkan nama Anda di sini"
              class="w-full px-4 py-3 text-sm bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900 transition-colors"
            />
          </div>

          <div>
            <label for="nomorMeja" class="block text-xs font-semibold text-stone-700 mb-1.5">
              Nomor Meja Saat Ini
            </label>
            <select
              id="nomorMeja"
              name="nomorMeja"
              class="w-full px-4 py-3 text-sm bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900 font-medium transition-colors"
            >
              <% for (let m = 1; m <= appConfig.jumlahMeja; m++) { %>
                <% const kodeMeja = String(m).padStart(2, '0'); %>
                <option value="<%= kodeMeja %>" <%= kodeMeja === String(mejaParam).padStart(2, '0') ? 'selected' : '' %>>
                  Meja <%= kodeMeja %> (Area Dine-In)
                </option>
              <% } %>
            </select>
          </div>

          <div class="pt-2">
            <button
              id="btn-submit-meja"
              type="submit"
              class="w-full py-3.5 px-5 bg-stone-900 hover:bg-stone-800 active:scale-[0.99] text-white font-semibold text-sm rounded-xl transition-all cursor-pointer shadow-xs flex items-center justify-center gap-2"
            >
              <span id="teks-btn-meja"><%= (typeof statusToko !== 'undefined' && !statusToko.sedangBuka) ? 'Cek Status Pesanan Meja & Lihat Katalog →' : 'Buka Buku Menu & Pesan Sekarang →' %></span>
            </button>
          </div>
        </form>

    </div>
  </main>

  <!-- Footer Bersih -->
  <footer class="w-full max-w-4xl mx-auto px-5 py-4 text-center text-xs text-stone-300">
    &copy; 2026 <%= appConfig.appName %> &mdash; Layanan Pemesanan Mandiri Meja
  </footer>

  <!-- Script Sinkronisasi Otomatis Status Buka/Tutup Toko di Halaman Check-In Meja -->
  <script>
    (function () {
      const badgeHeader = document.getElementById('badge-header-toko');
      const dotHeader = document.getElementById('dot-header-toko');
      const teksHeader = document.getElementById('teks-header-toko');
      const boxTutup = document.getElementById('box-toko-tutup');
      const alasanTutup = document.getElementById('alasan-toko-tutup');
      const alertErr = document.getElementById('alert-pesan-error');
      const inputNama = document.getElementById('namaPelanggan');
      const selectMeja = document.getElementById('nomorMeja');
      const btnSubmit = document.getElementById('btn-submit-meja');
      const teksBtn = document.getElementById('teks-btn-meja');

      setInterval(async () => {
        try {
          const res = await fetch('/api/sinkronisasi', { cache: 'no-store' });
          if (!res.ok) return;
          const data = await res.json();
          const st = data.statusToko;
          if (!st) return;

          if (st.sedangBuka) {
            badgeHeader.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full border text-[11px] font-semibold bg-emerald-50 border-emerald-200 text-emerald-800';
            dotHeader.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse';
            teksHeader.innerHTML = `Buka &middot; ${st.jamOperasional}`;
            boxTutup.classList.add('hidden');
            if (alertErr) alertErr.classList.add('hidden');
            teksBtn.textContent = 'Buka Buku Menu & Pesan Sekarang →';
          } else {
            badgeHeader.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full border text-[11px] font-semibold bg-red-50 border-red-200 text-red-800';
            dotHeader.className = 'w-1.5 h-1.5 rounded-full bg-red-600';
            teksHeader.innerHTML = `Toko Sedang Tutup &middot; ${st.jamOperasional}`;
            boxTutup.classList.remove('hidden');
            alasanTutup.textContent = st.alasan;
            teksBtn.textContent = 'Cek Status Pesanan Meja & Lihat Katalog →';
          }
        } catch (e) {}
      }, 2500);
    })();
  </script>

</body>
</html>
