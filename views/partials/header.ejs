<%#
  ============================================================================
  FILE: views/partials/header.ejs
  ============================================================================
%>
<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= judulHalaman %> — <%= appConfig.appName %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    @media print {
      .no-print { display: none !important; }
      body { background: #fff !important; color: #000 !important; }
    }
  </style>
</head>
<body class="bg-stone-100 text-stone-900 font-sans min-h-screen flex flex-col antialiased selection:bg-amber-800 selection:text-white">

  <!-- Header Navigasi -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-stone-200 no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
      
      <!-- Logo & Brand -->
      <a href="/" class="flex items-center gap-2.5 group">
        <span class="w-8 h-8 rounded-lg bg-stone-900 text-white flex items-center justify-center font-bold text-xs tracking-wider group-hover:bg-amber-800 transition-colors">
          DT
        </span>
        <div>
          <span class="font-bold text-sm tracking-tight text-stone-900 block leading-tight">
            <%= appConfig.appName %>
          </span>
          <span class="text-[11px] text-stone-500 block leading-none mt-0.5">
            <%= appConfig.brandSubtitle %>
          </span>
        </div>
      </a>

      <!-- Status Akses & Tombol Navigasi / Keluar -->
      <div class="flex items-center gap-3">
        <% if (currentUser) { %>
          <!-- Sesi Pemilik / Staf -->
          <div class="flex items-center gap-2">
            <% if (currentUser.role === 'pemilik') { %>
              <a
                href="/pemilik"
                class="px-3 py-1.5 rounded-lg text-xs font-semibold <%= halamanAktif === 'pemilik' ? 'bg-stone-900 text-white' : 'text-stone-600 hover:text-stone-900 bg-stone-50' %>"
              >
                Laporan Pemilik
              </a>
              <a
                href="/staf"
                class="px-3 py-1.5 rounded-lg text-xs font-semibold <%= halamanAktif === 'staf' ? 'bg-stone-900 text-white' : 'text-stone-600 hover:text-stone-900 bg-stone-50' %>"
              >
                Layar Dapur
              </a>
            <% } else { %>
              <span class="text-xs font-semibold text-stone-700 bg-stone-100 px-3 py-1.5 rounded-lg border border-stone-200">
                Staf: <%= currentUser.namaLengkap %>
              </span>
            <% } %>

            <a
              href="/logout"
              class="px-3 py-1.5 rounded-lg text-xs font-semibold text-red-700 hover:bg-red-50 border border-stone-200 transition-colors"
            >
              Keluar
            </a>
          </div>
        <% } else if (currentPelanggan) { %>
          <!-- Sesi Pelanggan Meja -->
          <div class="flex items-center gap-2.5">
            <span class="text-xs font-medium text-stone-700 bg-stone-50 border border-stone-200 px-3 py-1.5 rounded-lg">
              Pemesan: <strong><%= currentPelanggan.namaPelanggan %></strong> (Meja <%= currentPelanggan.nomorMeja %>)
            </span>
            <a
              href="/logout"
              class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-stone-500 hover:text-stone-900 hover:bg-stone-100 transition-colors"
              title="Ganti meja atau pemesan"
            >
              Ganti
            </a>
          </div>
        <% } %>
      </div>

    </div>
  </header>
