<%#
  ============================================================================
  FILE: views/partials/header.ejs
  ============================================================================
%>
<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= judulHalaman %> — <%= appConfig.appName %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    @media print {
      .no-print { display: none !important; }
      body { background: #fff !important; color: #000 !important; }
    }
  </style>
</head>
<body class="bg-stone-100 text-stone-900 font-sans min-h-screen flex flex-col antialiased selection:bg-amber-800 selection:text-white">

  <!-- Header Navigasi Responsif Mobile-First -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-stone-200 no-print">
    <div class="max-w-7xl mx-auto px-3.5 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-2">
      
      <!-- Logo & Brand Toko Kopi Simpanan -->
      <a href="/" class="flex items-center gap-2.5 group min-w-0">
        <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-700 to-stone-900 text-amber-100 flex items-center justify-center shrink-0 shadow-xs group-hover:from-amber-600 group-hover:to-stone-800 transition-all border border-amber-500/30">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 8h1a4 4 0 1 1 0 8h-1"/>
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/>
            <line x1="6" y1="2" x2="6" y2="4"/>
            <line x1="10" y1="2" x2="10" y2="4"/>
            <line x1="14" y1="2" x2="14" y2="4"/>
          </svg>
        </span>
        <div class="min-w-0">
          <span class="font-bold text-xs sm:text-sm tracking-tight text-stone-900 block leading-tight truncate">
            <%= appConfig.appName %>
          </span>
          <span class="text-[10px] sm:text-[11px] text-amber-800 font-semibold block leading-none mt-0.5 truncate">
            Signature Roastery &amp; Kitchen
          </span>
        </div>
      </a>

      <!-- Status Akses & Tombol Navigasi / Keluar -->
      <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
        <% if (currentUser) { %>
          <!-- Sesi Pemilik / Staf -->
          <div class="flex items-center gap-1.5 sm:gap-2">
            <% if (currentUser.role === 'pemilik') { %>
              <a
                href="/pemilik"
                class="px-2.5 sm:px-3 py-1.5 rounded-lg text-[11px] sm:text-xs font-semibold <%= halamanAktif === 'pemilik' ? 'bg-stone-900 text-white' : 'text-stone-600 hover:text-stone-900 bg-stone-50' %>"
              >
                <span class="hidden sm:inline">Laporan </span>Pemilik
              </a>
              <a
                href="/staf"
                class="px-2.5 sm:px-3 py-1.5 rounded-lg text-[11px] sm:text-xs font-semibold <%= halamanAktif === 'staf' ? 'bg-stone-900 text-white' : 'text-stone-600 hover:text-stone-900 bg-stone-50' %>"
              >
                <span class="hidden sm:inline">Layar </span>Dapur
              </a>
            <% } else { %>
              <span class="hidden sm:inline-block text-xs font-semibold text-stone-700 bg-stone-100 px-3 py-1.5 rounded-lg border border-stone-200">
                Staf: <%= currentUser.namaLengkap %>
              </span>
            <% } %>

            <a
              href="/logout?from=internal"
              class="px-2.5 sm:px-3 py-1.5 rounded-lg text-[11px] sm:text-xs font-semibold text-red-700 hover:bg-red-50 border border-stone-200 transition-colors"
            >
              Keluar
            </a>
          </div>
        <% } else if (currentPelanggan) { %>
          <!-- Sesi Pelanggan Meja (Ringkas & Rapi di HP) -->
          <div class="flex items-center gap-1.5 sm:gap-2">
            <span class="text-[11px] sm:text-xs font-medium text-stone-700 bg-stone-50 border border-stone-200 px-2.5 sm:px-3 py-1 rounded-lg max-w-[140px] sm:max-w-none truncate">
              <span class="hidden sm:inline">Pemesan: </span><strong><%= currentPelanggan.namaPelanggan %></strong>
            </span>
            <a
              href="/logout"
              class="px-2.5 py-1 rounded-lg text-[11px] sm:text-xs font-semibold text-stone-600 hover:text-stone-900 bg-stone-100 hover:bg-stone-200 transition-colors"
              title="Ganti meja atau pemesan"
            >
              Ganti
            </a>
          </div>
        <% } %>
      </div>

    </div>
  </header>
