<%#
  ============================================================================
  FILE: views/login-internal.ejs
  ============================================================================
  FUNGSI:
  Halaman Portal Login Khusus Pegawai Internal (Staf Dapur & Pemilik Kedai).
  Diakses melalui URL terpisah (`/portal-internal` atau `/staff`) sehingga
  tidak bercampur dengan halaman pemesanan pelanggan meja.
  - Scope B (Staf Dapur - Nazhat Hafidz Al Jauzi): Mengelola antrean FIFO & Stok.
  - Scope C (Pemilik Kedai - Dev Yuftiana Ayyun): Mengakses dashboard analitik & CSV.
%>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Portal Manajemen &amp; Staf — <%= appConfig.appName %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif']
          }
        }
      }
    };
  </script>
</head>
<body class="bg-stone-100 text-stone-900 font-sans min-h-screen flex flex-col justify-between antialiased selection:bg-amber-800 selection:text-white">

  <!-- Header Portal Internal -->
  <header class="w-full max-w-4xl mx-auto px-5 pt-6 pb-2 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-stone-900 text-white flex items-center justify-center font-bold text-sm shadow-xs">
        DT
      </div>
      <div>
        <span class="font-bold text-base text-stone-900 block leading-none"><%= appConfig.appName %></span>
        <span class="text-xs text-stone-500 block mt-1">Portal Operasional Dapur &amp; Manajemen</span>
      </div>
    </div>
    <div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-stone-200/80 text-stone-700 text-[11px] font-semibold">
        🔒 Area Khusus Internal Resto
      </span>
    </div>
  </header>

  <!-- Konten Utama: Kartu Login Staf Dapur & Pemilik -->
  <main class="flex-1 flex items-center justify-center px-4 py-6">
    <div class="w-full max-w-md bg-white rounded-3xl border border-stone-200/90 p-6 sm:p-8 shadow-sm">

      <div class="flex items-center justify-between gap-2 mb-3">
        <span class="inline-block text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-amber-100/80 text-amber-900">
          Otorisasi Pegawai
        </span>
        <!-- Sub-Tab: Pilih Role Internal -->
        <div class="inline-flex bg-stone-100 p-1 rounded-xl text-xs font-semibold">
          <button
            type="button"
            id="btn-role-pemilik"
            onclick="pilihRoleInternal('pemilik')"
            class="px-3 py-1 rounded-lg transition-all cursor-pointer bg-white text-stone-900 shadow-xs"
          >
            Pemilik
          </button>
          <button
            type="button"
            id="btn-role-staf"
            onclick="pilihRoleInternal('staf')"
            class="px-3 py-1 rounded-lg transition-all cursor-pointer text-stone-500 hover:text-stone-900"
          >
            Staf Dapur
          </button>
        </div>
      </div>

      <h1 id="judul-internal" class="text-xl font-bold text-stone-900">
        Login Pemilik Resto
      </h1>
      <p id="subjudul-internal" class="text-xs text-stone-500 mt-1 leading-relaxed">
        Akses khusus <strong>Dev Yuftiana Ayyun</strong> untuk memantau analitik penjualan terlaris, stok kritis, dan unduh laporan CSV.
      </p>

      <% if (pesanError) { %>
        <div class="mt-4 rounded-2xl bg-red-50 border border-red-200 px-4 py-3 text-xs text-red-800 font-medium">
          <%= pesanError %>
        </div>
      <% } %>

      <form action="/auth/login-internal" method="POST" class="mt-6 space-y-4">
        <input type="hidden" id="input-role-target" name="roleTarget" value="<%= roleAwal || 'pemilik' %>" />

        <div>
          <label for="username" class="block text-xs font-semibold text-stone-700 mb-1.5">
            Username Pegawai
          </label>
          <input
            id="username"
            name="username"
            type="text"
            required
            autocomplete="username"
            value="<%= roleAwal === 'staf' ? 'staf' : 'pemilik' %>"
            placeholder="pemilik atau staf"
            class="w-full px-4 py-3 text-sm bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900 transition-colors"
          />
        </div>

        <div>
          <label for="password" class="block text-xs font-semibold text-stone-700 mb-1.5">
            Kata Sandi
          </label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            value="password123"
            placeholder="Masukkan kata sandi"
            class="w-full px-4 py-3 text-sm bg-stone-50 border border-stone-300 rounded-xl focus:bg-white focus:outline-none focus:border-stone-900 transition-colors"
          />
        </div>

        <!-- Tombol Cepat Isi Kredensial Demo Praktikum -->
        <div class="pt-1 flex items-center justify-between text-[11px] text-stone-500">
          <span>Akun Demo Praktikum:</span>
          <div class="space-x-1.5">
            <button
              type="button"
              onclick="pilihRoleInternal('pemilik')"
              class="underline font-semibold text-stone-700 hover:text-stone-900 cursor-pointer"
            >
              Isi Akun Pemilik
            </button>
            <span>&middot;</span>
            <button
              type="button"
              onclick="pilihRoleInternal('staf')"
              class="underline font-semibold text-stone-700 hover:text-stone-900 cursor-pointer"
            >
              Isi Akun Staf
            </button>
          </div>
        </div>

        <div class="pt-2">
          <button
            type="submit"
            id="btn-submit-internal"
            class="w-full py-3.5 px-5 bg-stone-900 hover:bg-stone-800 active:scale-[0.99] text-white font-semibold text-sm rounded-xl transition-all cursor-pointer shadow-xs"
          >
            Masuk ke Dashboard Pemilik
          </button>
        </div>
      </form>

    </div>
  </main>

  <!-- Footer -->
  <footer class="w-full max-w-4xl mx-auto px-5 py-4 flex flex-col sm:flex-row items-center justify-between text-xs text-stone-400 gap-2">
    <span>&copy; 2026 <%= appConfig.appName %> (<%= appConfig.version %>)</span>
    <span><%= appConfig.authorName %> &middot; <%= appConfig.authorNim %></span>
  </footer>

  <script>
    function pilihRoleInternal(role) {
      const btnPemilik = document.getElementById('btn-role-pemilik');
      const btnStaf = document.getElementById('btn-role-staf');
      const judul = document.getElementById('judul-internal');
      const subjudul = document.getElementById('subjudul-internal');
      const inputUser = document.getElementById('username');
      const inputPass = document.getElementById('password');
      const inputRole = document.getElementById('input-role-target');
      const btnSubmit = document.getElementById('btn-submit-internal');

      inputRole.value = role;

      if (role === 'staf') {
        btnStaf.className = 'px-3 py-1 rounded-lg transition-all cursor-pointer bg-white text-stone-900 shadow-xs';
        btnPemilik.className = 'px-3 py-1 rounded-lg transition-all cursor-pointer text-stone-500 hover:text-stone-900';
        judul.textContent = 'Login Staf Dapur';
        subjudul.innerHTML = 'Akses khusus <strong>Nazhat Hafidz Al Jauzi</strong> untuk mengelola antrean masak FIFO dan stok bahan baku.';
        inputUser.value = 'staf';
        inputPass.value = 'password123';
        btnSubmit.textContent = 'Buka Layar Antrean Dapur';
      } else {
        btnPemilik.className = 'px-3 py-1 rounded-lg transition-all cursor-pointer bg-white text-stone-900 shadow-xs';
        btnStaf.className = 'px-3 py-1 rounded-lg transition-all cursor-pointer text-stone-500 hover:text-stone-900';
        judul.textContent = 'Login Pemilik Resto';
        subjudul.innerHTML = 'Akses khusus <strong>Dev Yuftiana Ayyun</strong> untuk memantau analitik penjualan terlaris, stok kritis, dan unduh laporan CSV.';
        inputUser.value = 'pemilik';
        inputPass.value = 'password123';
        btnSubmit.textContent = 'Masuk ke Dashboard Pemilik';
      }
    }

    (function () {
      const roleAwal = '<%= roleAwal %>';
      if (roleAwal === 'staf') {
        pilihRoleInternal('staf');
      }
    })();
  </script>
</body>
</html>
